{
  "name": "@nubisco/openbridge",
  "version": "0.29.0",
  "description": "Local-first home automation bridge for developers. Plugin-based, TypeScript-first, Homebridge-compatible.",
  "author": "José Silva <jose@nubisco.io>",
  "license": "MIT",
  "homepage": "https://github.com/nubisco/openbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubisco/openbridge.git",
    "directory": "apps/daemon"
  },
  "bugs": {
    "url": "https://github.com/nubisco/openbridge/issues"
  },
  "keywords": [
    "homebridge",
    "homekit",
    "home-automation",
    "hap",
    "smart-home",
    "plugin",
    "bridge",
    "typescript",
    "docker",
    "nas",
    "synology"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "openbridge": "./dist/index.js",
    "openbridge-daemon": "./dist/index.js"
  },
  "files": [
    "dist/",
    "ui-dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "OPENBRIDGE_DEV=true tsx watch --include $HOME/.openbridge/plugins/openbridge src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@nubisco/openbridge-compatibility-homebridge": "workspace:*",
    "@nubisco/openbridge-config": "workspace:*",
    "@nubisco/openbridge-core": "workspace:*",
    "@nubisco/openbridge-logger": "workspace:*",
    "fastify": "^5.12.7",
    "hap-nodejs": "^0.14.3",
    "qrcode-terminal": "^0.12.0",
    "systeminformation": "^5.33.16",
    "zod": "^4.3.5"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
